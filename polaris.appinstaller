    xmlns="http://schemas.microsoft.com/appx/appinstaller/2018">

    <MainPackage
        Name="Khromalabs.AinaraPolaris"
        Publisher='CN="Open Source Developer, RUBEN GOMEZ AGUDO", O=Open Source Developer, L=Madrid, S=Madrid, C=ES'
