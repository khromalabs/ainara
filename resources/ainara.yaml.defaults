# Default Ainara Configuration

# Speech-to-Text configuration
stt:
  # Default backend to use
  selected_module: "faster_whisper"
  language: "en"
  modules:
    faster_whisper:
      model_size: "small"

# Text-to-Speech configuration
tts:
  # Default backend to use
  selected_module: "kokoro"
  modules:
    kokoro:
      default_lang: en-us
      default_voice: af_heart
      # "auto" = min(4, logical_cpus // 2); or set an explicit integer
      num_threads: "auto"

# LLM configuration
llm:
  # Default backend to use
  selected_backend: "litellm"
  selected_provider: ""
  providers: []
    # Example provider configuration:
    # - model: "openai/gpt-3.5-turbo"
    #   api_base: "http://127.0.0.1:8000/v1"
    #   api_key: "nokey"
    #   context_window: 8192

# Ainara configuration
orakle:
  servers:
    - "http://127.0.0.1:8100"

# Audio configuration
audio:
  buffer_size_mb: 10

# Backup configuration
backup:
  # Enable or disable automatic backups
  enabled: false
  # Directory to store backup files (e.g., a folder synced with Dropbox/Google Drive)
  # Leave empty to disable backups.
  directory: ""
  # Interval in hours between backups
  interval_hours: 24
  # Number of old backup versions to keep
  versions_to_keep: 7
  # Optional password to encrypt backups (leave empty for no encryption)
  password: ""

# Memory configuration
memory:
  enabled: true
  vector_db_enabled: true
  summary_enabled: true
  session_id: "default_session"
#  embedding_model: "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
#  storage_path: "~/.config/ainara/chat_memory.db"
#  vector_db_path: "~/.config/ainara/vector_db"

# APIs
apis:
  coinmarketcap:
    api_key: ""
  cryptoexchanges:
    hyperliquid:
      api_key: ""
      secret: ""
      wallet_address: ""
  helius:
    api_key: ""
  # Example configuration for an exchange (e.g., binance, kraken, coinbase)
  # cryptoexchanges:
  #   binance:
  #     api_key: ""
  #     secret: ""
  #     password: "" # Only required for some exchanges
  #     sandbox_mode: true
  finance:
    alphavantage_api_key: ""
  # reddit:
  #   client_id: ""
  #   client_secret: ""
  search:
    # google:
    #   api_key: ""
    #   cx: ""
    metaphor:
      api_key: ""
    newsapi:
      api_key: ""
    perplexity:
      api_key: ""
    tavily:
      api_key: ""
  # twitter:
  #   access_token: ""
  #   access_token_secret: ""
  #   api_key: ""
  #   api_secret: ""
  #   bearer_token: ""
  weather:
    openweathermap_api_key: ""

#mcp_clients:
#  <server>:
#    prefix: "" # optional
#    stdio_params:
#      command:
#      - <command>
#      - <arg1>
#      - '<arg2>'
#      env:
#        <key>: <value>

# Logging configuration (uncomment to customize)
# logging:
#   # Enable or disable file logging (console logging is always enabled)
#   file_enabled: true
#   # Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
#   level: "INFO"
#   # Custom log directory (leave empty for platform-specific default)
#   # Examples:
#   # - Windows: %LOCALAPPDATA%\Ainara\logs
#   # - macOS: ~/Library/Logs/Ainara
#   # - Linux: ~/.local/share/ainara/logs
#   directory: ""
#   # Maximum log file size in MB before rotation
#   max_size_mb: 1
#   # Number of backup log files to keep
#   backup_count: 5

# Cache configuration (uncomment to customize)
# cache:
#   # Custom cache directory (leave empty for platform-specific default)
#   # Examples:
#   # - Windows: %LOCALAPPDATA%\Ainara\Cache
#   # - macOS: ~/Library/Caches/Ainara
#   # - Linux: ~/.cache/ainara
#   directory: ""
#   # Path for sentence-transformers models cache
#   sentence_transformers_home: ""

# Data configuration (uncomment to customize)
# data:
#   # Custom cache directory (leave empty for platform-specific default)
#   # Examples:
#   # - Windows: %LOCALAPPDATA%\Appdata\Local
#   # - macOS: ~/Library/Application/Support
#   # - Linux: ~/.local/state
#   directory: ""
