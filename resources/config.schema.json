{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Ainara Configuration Schema",
    "type": "object",
    "properties": {
        "search": {
            "type": "object",
            "description": "Meta-search configuration (SearchWeb skill).",
            "properties": {
                "web": {
                    "type": "object",
                    "description": "Web meta-search settings.",
                    "properties": {
                        "user_engines_directory": {
                            "type": "string",
                            "description": "Directory scanned for user-contributed search engines (SearchEngineBase modules, one class per .py file). Each module is imported as a top-level module; per-engine settings go under apis.search.<module name>."
                        }
                    }
                }
            }
        },
        "skills": {
            "type": "object",
            "description": "Container for skills configuration.",
            "properties": {
                "disabled": {
                    "type": "array",
                    "items": {"type": "string"},
                    "description": "Denylist of capability IDs excluded from routing, scheduling and execution. Everything not listed stays enabled."
                }
            },
            "additionalProperties": true
        },
        "apis": {
            "type": "object",
            "description": "Container for various external API keys and settings.",
            "properties": {
                "coinmarketcal": {
                    "type": "object",
                    "properties": {
                        "api_key": {"type": "string"}
                    }
                },
                "coinmarketcap": {
                    "type": "object",
                    "properties": {
                        "api_key": {"type": "string"}
                    }
                },
                "helius": {
                    "type": "object",
                    "properties": {
                        "api_key": {"type": "string"}
                    }
                },
                "cryptoexchanges": {
                    "type": "object",
                    "description": "Configuration for CCXT crypto exchanges.",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "api_key": {"type": "string"},
                            "secret": {"type": "string"},
                            "password": {"type": "string"},
                            "sandbox_mode": {"type": "boolean"},
                            "wallet_address": {"type": "string"},
                            "default_type": {"type": "string"},
                            "default_quote": {"type": "string"}
                        },
                        "required": ["api_key", "secret"]
                    }
                },
                "finance": {
                    "type": "object",
                    "properties": {"alphavantage_api_key": {"type": "string"}},
                    "required": ["alphavantage_api_key"]
                },
                "search": {
                    "type": "object",
                    "properties": {
                        "newsapi": {"type": "object", "properties": {"api_key": {"type": "string"}}},
                        "perplexity": {"type": "object", "properties": {"api_key": {"type": "string"}}},
                        "brave": {"type": "object", "description": "Brave Search API (https://brave.com/search/api/).", "properties": {"api_key": {"type": "string"}}},
                        "tavily": {"type": "object", "properties": {"api_key": {"type": "string"}}},
                        "guavy": {"type": "object", "properties": {"api_key": {"type": "string"}}},
                        "searxng": {
                            "type": "object",
                            "description": "Self-hosted SearXNG metasearch instance (keyless). Opt-in: leave base_url empty to disable SearXNG; set it (e.g. http://127.0.0.1:8888) to enable. The instance must allow JSON output ('json' in its search.formats setting). api_key is optional.",
                            "properties": {
                                "base_url": {"type": "string", "format": "uri", "default": "http://127.0.0.1:8888"},
                                "api_key": {"type": "string"},
                                "category_map": {
                                    "type": "object",
                                    "description": "Optional mapping from SearchWeb search types (e.g. 'news', 'academic') to SearXNG categories.",
                                    "additionalProperties": {"type": "string"}
                                }
                            }
                        }
                    }
                },
                "weather": {
                    "type": "object",
                    "properties": {"openweathermap_api_key": {"type": "string"}},
                    "required": ["openweathermap_api_key"]
                }
            }
        },
        "audio": {
            "type": "object",
            "properties": {
                "buffer_size_mb": {"type": "integer", "minimum": 1}
            }
        },
        "backup": {
            "type": "object",
            "properties": {
                "directory": {"type": "string"},
                "enabled": {"type": "boolean"},
                "interval_hours": {"type": "integer", "minimum": 1},
                "password": {"type": "string"},
                "versions_to_keep": {"type": "integer", "minimum": 0}
            }
        },
        "cache": {
            "type": "object",
            "properties": {
                "directory": {"type": "string"},
                "sentence_transformers_home": {"type": "string"}
            }
        },
        "data": {
            "type": "object",
            "properties": {
                "directory": {"type": "string"}
            }
        },
        "llm": {
            "type": "object",
            "properties": {
                "directory": {"type": "string"},
                "logging": {"type": ["string", "null"]},
                "model_contexts": {
                    "type": "object",
                    "additionalProperties": {"type": "integer"}
                },
                "providers": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "model": {"type": "string"},
                            "context_window": {"type": "integer"},
                            "api_key": {"type": "string"},
                            "api_base": {"type": "string", "format": "uri"},
                            "enable_thinking": {"type": "boolean"},
                            "reasoning_effort": {
                                "type": "string",
                                "enum": ["low", "medium", "high", "minimal"],
                                "description": "Default reasoning effort requested for this model on every call (main chat, Orakle selection, agent plan steps, GREEN memories). Undeclared means the parameter is not sent (provider default applies). Ignored with a warning for models whose provider rejects the parameter; an explicit per-call effort still takes precedence."
                            }
                        },
                        "required": ["model"]
                    }
                },
                "memories_processors": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "selected_backend": {"type": "string"},
                "selected_provider": {"type": "string"}
            },
            "required": ["providers", "selected_backend", "selected_provider"]
        },
        "logging": {
            "type": "object",
            "properties": {
                "directory": {"type": "string"}
            }
        },
        "mcp_clients": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "properties": {
                    "prefix": {"type": "string"},
                    "stdio_params": {
                        "type": "object",
                        "properties": {
                            "command": {"type": "array", "items": {"type": "string"}},
                            "env": {
                                "type": "object",
                                "additionalProperties": {"type": "string"}
                            }
                        },
                        "required": ["command"]
                    }
                },
                "required": ["stdio_params"]
            }
        },
        "memory": {
            "type": "object",
            "properties": {
                "enabled": {"type": "boolean"},
                "session_id": {"type": "string"},
                "summary_enabled": {"type": "boolean"},
                "vector_db_enabled": {"type": "boolean"},
                "injection": {
                    "type": "object",
                    "properties": {
                        "semantic_floor": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1,
                            "description": "GREEN 2.0 (issue #33): semantic-only floor for contextual memory injection. Candidates whose cosine-similarity component falls below this value are pruned regardless of importance/recency. Weak gate by design: prune egregious noise only; 0 disables."
                        },
                        "search_history_exchanges": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 10,
                            "default": 2,
                            "description": "Recent user/assistant exchanges embedded to seed contextual memory retrieval. Only reference resolution needs them — conversational continuity is carried by the session topic — so more turns mostly add noise."
                        },
                        "topic_boost": {
                            "type": "object",
                            "properties": {
                                "assistant_weight": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1,
                                    "default": 0.4,
                                    "description": "Relevance multiplier contribution for memories whose topic matches the assistant-evaluated session topic (most authoritative source; detected in the background from the settled exchange)."
                                },
                                "query_weight": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1,
                                    "default": 0.3,
                                    "description": "Relevance multiplier contribution for memories whose topic matches the topics semantically matched from the raw search context (instant reaction to the latest turn; noisier)."
                                },
                                "max_topics": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 50,
                                    "default": 5,
                                    "description": "Rank-based cap on query-side matched topics. A fixed absolute threshold is not scale-invariant with vocabulary size (noise text crosses any useful threshold when taking the max over thousands of labels), so the boost set is bounded by rank instead."
                                },
                                "max_session_topics": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 50,
                                    "default": 10,
                                    "description": "Rank-based cap on stored topics mapped from the generated session-topic label (higher-precision matches than the query side, so a wider cap)."
                                },
                                "min_similarity": {
                                    "type": "number",
                                    "minimum": 0,
                                    "maximum": 1,
                                    "default": 0.2,
                                    "description": "Low similarity floor applied after the rank caps: text whose best topic match is below this boosts nothing at all."
                                }
                            }
                        },
                        "session_topic": {
                            "type": "object",
                            "properties": {
                                "classifier_enabled": {
                                    "type": "boolean",
                                    "default": true,
                                    "description": "Per-turn background LLM call that GENERATES a free-form topic label for the current conversation (or NONE for small talk). Disable to rely only on the topic fused into the background summary pass."
                                },
                                "detection_window_messages": {
                                    "type": "integer",
                                    "minimum": 2,
                                    "maximum": 50,
                                    "default": 10,
                                    "description": "How many recent messages the topic classifier sees. Older context is already carried by the conversation summary, so more adds cost without information."
                                },
                                "max_message_chars": {
                                    "type": "integer",
                                    "minimum": 50,
                                    "maximum": 2000,
                                    "default": 250,
                                    "description": "Per-message truncation inside the classifier window — topic detection needs the gist, not message bodies. Bounds the window cost worst-case."
                                },
                                "max_age_turns": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "maximum": 20,
                                    "default": 3,
                                    "description": "Turns the session topic stays active without fresh background confirmation before it stops boosting retrieval."
                                }
                            }
                        }
                    }
                }
            }
        },
        "deep_recall": {
            "type": "object",
            "description": "Deep Recall: deliberative investigation of the user's memories and past conversations (exposed as the deep_recall system skill; triggered by the model through the ordinary ORAKLE channel).",
            "additionalProperties": true,
            "properties": {
                "max_turns": {
                    "type": "integer",
                    "minimum": 0,
                    "default": 6,
                    "description": "Expert-level: maximum investigation turns per Deep Recall run (0 disables Deep Recall entirely). Expert setting — never surfaced in the setup wizard."
                }
            }
        },
        "orakle": {
            "type": "object",
            "properties": {
                "servers": {
                    "type": "array",
                    "items": {"type": "string", "format": "uri"}
                },
                "match_providers": {
                    "type": "array",
                    "items": { "type": "string" }
                },
                "enable_agent_spawn": {
                    "type": "boolean",
                    "default": false,
                    "description": "Master switch for ephemeral Bureau agent spawning (requires_agent queries and issue #26 offload-digest routing). Off by default; standing consent is granted via the wizard."
                },
                "nexus": {
                    "type": "object",
                    "properties": {
                        "data_inline_max_bytes": {
                            "type": "integer",
                            "default": 24000,
                            "description": "UI-skill payload size above which the render channel switches from inlining the data into the transcript to storing it as a persistent render blob referenced by data_ref (hydrated by Polaris via GET /attachments/<id>); issue #26 P2, §6.8. Small payloads render exactly as before."
                        }
                    }
                },
                "offload": {
                    "type": "object",
                    "properties": {
                        "raw_max_bytes": {
                            "type": "integer",
                            "default": 0,
                            "description": "Optional lowering override on the derived offload size trigger (issue #37): the trigger derives from the live context window (trigger_share of the usable window — the payload-to-window ratio is what actually predicts degradation) and this key only ever lowers it — a user-facing 'never route anything bigger than this to analysis' override, not a per-model setting. 0 (default) disables the override; when no context window can be resolved the trigger falls back to a built-in static byte comparison that this key lowers too."
                        },
                        "trigger_share": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 1,
                            "default": 0.5,
                            "description": "One share of the usable context window bounding all three derived sizing checks (issue #37): the C1 size trigger (payload alone would take this share of the usable window), the C2 digestion input feasibility, and the C4 share bound on the returned digest. Deliberately one key — the checks form one escalator; independent shares would re-create the independent-magic-numbers problem."
                        },
                        "digest_max_chars": {
                            "type": "integer",
                            "default": 16384,
                            "description": "Absolute ceiling on a returned digest, in characters (issue #37, C4): the active bound is min(this ceiling, the interpreter's history-share bytes), because the trail rides the history. The digestion prompt mandates the same number, so instruction and guard agree; a digest above the bound is treated as a failed digestion — guidance, no retry, never forwarded."
                        },
                        "max_turns": {
                            "type": "integer",
                            "default": 4,
                            "description": "Turn bound for the bounded, skill-less digestion agent."
                        },
                        "timeout": {
                            "type": "integer",
                            "default": 300,
                            "description": "Execution timeout (seconds) for the digestion agent."
                        },
                        "spend_policy": {
                            "type": "string",
                            "enum": ["ask", "allow", "deny"],
                            "default": "ask",
                            "description": "Consent posture for offload digestion when the digestion model is a metered (cloud, paid) provider (#26 P2, ratified with #18): 'ask' shows a framework-rendered consent card per oversized result, 'allow' is a deliberate standing consent granted via the wizard's standing-consent step (the card's always-allow button upgrades the posture for the current session only), 'deny' rejects with guidance. Local (non-metered) digestion runs under every policy."
                        },
                        "consent_ttl": {
                            "type": "integer",
                            "default": 600,
                            "description": "Lifetime (seconds) of a pending consent-card decision token; expiry is a no-op — the card dies and nothing auto-executes (#26 P2)."
                        },
                        "digest_cache": {
                            "type": "object",
                            "properties": {
                                "enabled": {
                                    "type": "boolean",
                                    "default": true,
                                    "description": "Reuse offload digests for byte-identical oversized results (payload-hash keyed, in-memory, session-scoped) instead of paying for a repeated digestion agent run (issue #26)."
                                },
                                "max_entries": {
                                    "type": "integer",
                                    "default": 8,
                                    "description": "Maximum cached digests (LRU-evicted)."
                                }
                            }
                        }
                    }
                },
                "context": {
                    "type": "object",
                    "properties": {
                        "reserve_pct": {
                            "type": "integer",
                            "default": 25,
                            "description": "Percentage of the context window kept free (answer + follow-up headroom) when the budget ledger gates the interpretation prompt (issue #26 §6.9)."
                        },
                        "chars_per_token": {
                            "type": "integer",
                            "default": 3,
                            "description": "Conservative bytes-per-token conversion for the budget ledger, multilingual-safe."
                        },
                        "effective_window_cap": {
                            "type": "integer",
                            "default": 128000,
                            "description": "Effective-context ceiling in tokens (issue #37, research-backed): long-context accuracy degrades well before the advertised window (lost-in-the-middle; degradation even with perfect retrieval; multi-hop reasoning suffers most; effective context diverges from advertised beyond 128K-256K tokens). Every window-derived budget — interpretation prompt ledger, history share, and the offload sizing escalator — assumes at most this many tokens regardless of the resolved window. 0 disables the cap (expert override: accept the degradation)."
                        },
                        "interpretation_history": {
                            "type": "boolean",
                            "default": true,
                            "description": "Ledger-driven interpretation history window (issue #26 §6.10): the interpreter sees as much recent conversation as fits its share of the ledger budget (floored at 4 messages). false restores the fixed last-4-messages slice — the one-key rollback for small-model regressions."
                        },
                        "interpretation_history_share": {
                            "type": "integer",
                            "default": 40,
                            "description": "Maximum share (percent) of the ledger budget the interpreter's history window may occupy, so history never squeezes the payload/answer space (issue #26 §6.10)."
                        }
                    }
                }
            },
            "required": ["servers"]
        },
        "stt": {
            "type": "object",
            "properties": {
                "language": {"type": "string"},
                "selected_module": {"type": "string", "enum": ["faster_whisper", "whisper"]},
                "modules": {
                    "type": "object",
                    "properties": {
                        "faster_whisper": {
                            "type": "object",
                            "properties": {
                                "model_size": {"type": "string"}
                            }
                        },
                        "whisper": {
                            "type": "object",
                            "properties": {
                                "custom": {
                                    "type": "object",
                                    "properties": {
                                        "api_key": {"type": "string"},
                                        "api_url": {"type": "string", "format": "uri"},
                                        "headers": {"type": "object"},
                                        "model": {"type": "string"}
                                    }
                                },
                                "service": {"type": "string"}
                            }
                        }
                    }
                }
            },
            "required": ["selected_module", "modules"]
        },
        "tts": {
            "type": "object",
            "properties": {
                "selected_module": {"type": "string", "enum": ["piper", "elevenlabs",  "coqui", "kokoro"]},
                "modules": {
                    "type": "object",
                    "properties": {
                        "elevenlabs": {
                            "type": "object",
                            "properties": {
                                "api_key": {"type": "string"},
                                "voice": {"type": "string"}
                            }
                        },
                        "kokoro": {
                            "type": "object",
                            "properties": {
                                "default_lang": {"type": "string"},
                                "default_voice": {"type": "string"},
                                "default_speed": {"type": "string"},
                                "num_threads": {
                                    "oneOf": [
                                        {"type": "string", "enum": ["auto"]},
                                        {"type": "integer", "minimum": 1}
                                    ]
                                },
                                "languages": {
                                    "type": "object",
                                    "patternProperties": {
                                        "^[a-z]{2,3}$": {
                                            "type": "object",
                                            "properties": {
                                                "lang": {"type": "string"},
                                                "voice": {"type": "string"},
                                                "speed": {"type": "string"}
                                            },
                                            "required": ["voice"]
                                        }
                                    }
                                }
                            }
                        },
                        "piper": {
                            "type": "object",
                            "properties": {
                                "binary_path": {"type": "string"},
                                "default_voice": {"type": "string"},
                                "default_options": {"type": "string"},
                                "languages": {
                                    "type": "object",
                                    "patternProperties": {
                                        "^[a-z]{2,3}$": {
                                            "type": "object",
                                            "properties": {
                                                "voice": {"type": "string"},
                                                "options": {"type": "string"}
                                            },
                                            "required": ["voice"]
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "required": ["selected_module", "modules"]
        }
    },
    "required": ["stt", "tts", "llm", "orakle"]
}
